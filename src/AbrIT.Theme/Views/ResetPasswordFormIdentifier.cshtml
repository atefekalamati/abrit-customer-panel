@model ResetPasswordViewModel
@{
    var newPasswordId = Html.IdFor(m => m.NewPassword);
    var confirmId = Html.IdFor(m => m.PasswordConfirmation);
}
<input asp-for="ResetToken" type="hidden" />

<div class="abr-field">
    <label asp-for="UsernameOrEmail">ایمیل یا نام کاربری</label>
    <div class="abr-inputwrap">
        @Icons.Svg("mail")
        <input asp-for="UsernameOrEmail" class="abr-input ltr" dir="ltr" autocomplete="username" autocapitalize="none" spellcheck="false" aria-required="true" autofocus />
    </div>
</div>

<div class="abr-field">
    <label asp-for="NewPassword">رمز عبور جدید</label>
    <div class="abr-inputwrap">
        @Icons.Svg("lock")
        <input asp-for="NewPassword" class="abr-input ltr" dir="ltr" autocomplete="new-password" aria-required="true" aria-describedby="@(newPasswordId)-rules" />
        <partial name="_PasswordToggle" model="newPasswordId" />
    </div>
</div>

<div class="abr-field">
    <label asp-for="PasswordConfirmation">تکرار رمز عبور جدید</label>
    <div class="abr-inputwrap">
        @Icons.Svg("lock")
        <input asp-for="PasswordConfirmation" class="abr-input ltr" dir="ltr" autocomplete="new-password" aria-required="true" />
        <partial name="_PasswordToggle" model="confirmId" />
    </div>
</div>

<partial name="_PasswordRules" model="newPasswordId" />
