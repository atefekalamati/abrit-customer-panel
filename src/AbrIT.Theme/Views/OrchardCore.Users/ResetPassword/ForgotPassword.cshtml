@{
    RenderTitleSegments(new HtmlString("بازیابی رمز عبور"));
}
<div class="abr-authpage">
    @await DisplayAsync(await New.AbrPageHeader(
        Title: "بازیابی رمز عبور",
        Subtitle: "لینک بازیابی رمز عبور به ایمیل شما ارسال می‌شود.",
        Crumbs: new[] { new Crumb("ورود به حساب کاربری", Url.Action("Login", "Account", new { area = "OrchardCore.Users" })), new Crumb("بازیابی رمز عبور") }))

    <div class="abr-authstack">
        <div class="abr-authstack__art"><img src="~/AbrIT.Theme/img/cloud-lock.webp" alt="" width="900" height="660" decoding="async" fetchpriority="high" /></div>
        <section class="abr-auth" aria-labelledby="abr-auth-title">
            <div class="abr-auth__head">
                <h2 class="abr-auth__title" id="abr-auth-title">فراموشی رمز عبور</h2>
                <p class="abr-auth__sub">ایمیل یا نام کاربری حساب خود را وارد کنید.</p>
            </div>

            <partial name="_FormErrors" />

            @await DisplayAsync(Model)

            <a class="abr-backlink" asp-area="OrchardCore.Users" asp-controller="Account" asp-action="Login">بازگشت به ورود @Icons.Svg("chevron-left", 18)</a>
        </section>
    </div>

    @await DisplayAsync(await New.AbrAlert(
        Kind: "info",
        Title: "نکته‌ی امنیتی",
        Body: "برای حفظ امنیت حساب‌ها، نتیجه‌ی درخواست همیشه یکسان نمایش داده می‌شود؛ اگر حسابی با این مشخصات وجود داشته باشد، لینک تغییر رمز عبور به ایمیل آن ارسال می‌شود."))
</div>
