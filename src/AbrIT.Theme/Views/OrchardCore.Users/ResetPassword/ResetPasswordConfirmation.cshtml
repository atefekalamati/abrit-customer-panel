@{
    RenderTitleSegments(new HtmlString("تعیین رمز عبور جدید"));
}
<div class="abr-authpage">
    @await DisplayAsync(await New.AbrPageHeader(
        Title: "تعیین رمز عبور جدید",
        Subtitle: "رمز عبور شما به‌روز شد.",
        Crumbs: new[] { new Crumb("ورود به حساب کاربری", Url.Action("Login", "Account", new { area = "OrchardCore.Users" })), new Crumb("تعیین رمز جدید") }))

    <div class="abr-authstack">
        <div class="abr-authstack__art" aria-hidden="true"><partial name="_ArtCloud" model="@("key")" /></div>
        <section class="abr-auth" aria-labelledby="abr-auth-title">
            <div class="abr-auth__head">
                <h2 class="abr-auth__title" id="abr-auth-title">رمز عبور تغییر کرد</h2>
            </div>
            @await DisplayAsync(await New.AbrAlert(
                Kind: "success",
                Title: "انجام شد",
                Body: "رمز عبور جدید ذخیره شد. اکنون می‌توانید با آن وارد شوید."))
            <a class="abr-btn abr-btn--primary abr-btn--block abr-btn--lg" asp-area="OrchardCore.Users" asp-controller="Account" asp-action="Login">@Icons.Svg("login", 20) ورود به حساب</a>
        </section>
    </div>
</div>
