@{
    RenderTitleSegments(new HtmlString("تعیین رمز عبور جدید"));
}
<div class="abr-authpage">
    @await DisplayAsync(await New.AbrPageHeader(
        Title: "تعیین رمز عبور جدید",
        Subtitle: "یک رمز عبور جدید برای حساب خود انتخاب کنید.",
        Crumbs: new[] { new Crumb("ورود به حساب کاربری", Url.Action("Login", "Account", new { area = "OrchardCore.Users" })), new Crumb("تعیین رمز جدید") }))

    <div class="abr-authstack">
        <div class="abr-authstack__art"><img src="~/AbrIT.Theme/img/cloud-key.webp" alt="" width="900" height="662" decoding="async" fetchpriority="high" /></div>
        <section class="abr-auth" aria-labelledby="abr-auth-title">
            <h2 class="sr-only" id="abr-auth-title">فرم تعیین رمز عبور جدید</h2>

            <partial name="_FormErrors" />

            @await DisplayAsync(Model)

            <a class="abr-backlink" asp-area="OrchardCore.Users" asp-controller="Account" asp-action="Login">بازگشت به ورود @Icons.Svg("chevron-left", 18)</a>
        </section>
    </div>

    @await DisplayAsync(await New.AbrAlert(
        Kind: "info",
        Title: "نکته‌ی امنیتی",
        Body: "لینک تعیین رمز فقط یک بار و برای مدت محدود معتبر است."))
</div>
