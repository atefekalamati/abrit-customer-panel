@{
    RenderTitleSegments(new HtmlString("بازیابی رمز عبور"));
}
<div class="abr-authpage">
    @await DisplayAsync(await New.AbrPageHeader(
        Title: "بازیابی رمز عبور",
        Subtitle: "درخواست شما ثبت شد.",
        Crumbs: new[] { new Crumb("ورود به حساب کاربری", Url.Action("Login", "Account", new { area = "OrchardCore.Users" })), new Crumb("بازیابی رمز عبور") }))

    <div class="abr-authstack">
        <div class="abr-authstack__art" aria-hidden="true"><partial name="_ArtCloud" model="@("lock")" /></div>
        <section class="abr-auth" aria-labelledby="abr-auth-title">
            <div class="abr-auth__head">
                <h2 class="abr-auth__title" id="abr-auth-title">ایمیل خود را بررسی کنید</h2>
            </div>
            @await DisplayAsync(await New.AbrAlert(
                Kind: "success",
                Title: "درخواست بازیابی ثبت شد",
                Body: "اگر حسابی با این مشخصات وجود داشته باشد، لینک تعیین رمز عبور جدید به ایمیل آن ارسال شد. لینک فقط یک بار و برای مدت محدود معتبر است."))
            <p class="abr-note">در محیط ارزیابی ایمیل‌ها به <bdi>smtp4dev</bdi> (اجرای Docker) یا پوشه‌ی <bdi dir="ltr">App_Data/mail</bdi> (اجرای محلی) می‌روند.</p>
            <a class="abr-btn abr-btn--normal abr-btn--block" asp-area="OrchardCore.Users" asp-controller="Account" asp-action="Login">@Icons.Svg("login", 18) بازگشت به ورود</a>
        </section>
    </div>
</div>
