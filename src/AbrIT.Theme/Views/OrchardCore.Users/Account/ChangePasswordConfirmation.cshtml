@* Shown after a successful password change; same card and success alert as the reset-password confirmation. *@
@{
    RenderTitleSegments(new HtmlString("تغییر رمز عبور"));
}
<div class="abr-authpage">
    @await DisplayAsync(await New.AbrPageHeader(
        Title: "تغییر رمز عبور",
        Subtitle: "رمز عبور حساب شما به‌روز شد.",
        Crumbs: new[] { new Crumb("حساب کاربری"), new Crumb("تغییر رمز عبور") }))

    <div class="abr-authstack">
        <div class="abr-authstack__art"><img src="~/AbrIT.Theme/img/cloud-key.webp" alt="" width="900" height="662" decoding="async" fetchpriority="high" /></div>
        <section class="abr-auth" aria-labelledby="abr-auth-title">
            <div class="abr-auth__head">
                <h2 class="abr-auth__title" id="abr-auth-title">تغییر رمز عبور</h2>
            </div>
            @await DisplayAsync(await New.AbrAlert(
                Kind: "success",
                Title: "انجام شد",
                Body: "رمز عبور شما با موفقیت تغییر کرد. از این پس با رمز جدید وارد شوید."))
            <a class="abr-btn abr-btn--primary abr-btn--block abr-btn--lg" href="~/dashboard">@Icons.Svg("dashboard", 20) بازگشت به داشبورد</a>
        </section>
    </div>
</div>
