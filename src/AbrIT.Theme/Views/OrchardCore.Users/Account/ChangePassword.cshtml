@* Signed-in «حساب کاربری» → change password. Overrides Orchard's Bootstrap view so it uses the same centred abr-auth
   card as the sign-in pages, inside the signed-in layout. Same form fields/action as Orchard's view. *@
@model ChangePasswordViewModel
@{
    RenderTitleSegments(new HtmlString("تغییر رمز عبور"));
    var currentId = Html.IdFor(m => m.CurrentPassword);
    var newPasswordId = Html.IdFor(m => m.Password);
    var confirmId = Html.IdFor(m => m.PasswordConfirmation);
}
<div class="abr-authpage">
    @await DisplayAsync(await New.AbrPageHeader(
        Title: "تغییر رمز عبور",
        Subtitle: "برای امنیت حساب، رمز فعلی و سپس رمز جدید را وارد کنید.",
        Crumbs: new[] { new Crumb("حساب کاربری"), new Crumb("تغییر رمز عبور") }))

    <div class="abr-authstack">
        <div class="abr-authstack__art"><img src="~/AbrIT.Theme/img/cloud-key.webp" alt="" width="900" height="662" decoding="async" fetchpriority="high" /></div>
        <section class="abr-auth" aria-labelledby="abr-auth-title">
            <h2 class="sr-only" id="abr-auth-title">فرم تغییر رمز عبور</h2>

            <partial name="_FormErrors" />

            <form asp-area="OrchardCore.Users" asp-controller="Account" asp-action="ChangePassword" method="post" class="abr-form no-multisubmit" novalidate>
                <div class="abr-field">
                    <label asp-for="CurrentPassword">رمز عبور فعلی</label>
                    <div class="abr-inputwrap">
                        @Icons.Svg("key")
                        <input asp-for="CurrentPassword" class="abr-input ltr" dir="ltr" autocomplete="current-password" aria-required="true" autofocus />
                        <partial name="_PasswordToggle" model="currentId" />
                    </div>
                </div>

                <div class="abr-field">
                    <label asp-for="Password">رمز عبور جدید</label>
                    <div class="abr-inputwrap">
                        @Icons.Svg("lock")
                        <input asp-for="Password" class="abr-input ltr" dir="ltr" autocomplete="new-password" aria-required="true" aria-describedby="@(newPasswordId)-rules" />
                        <partial name="_PasswordToggle" model="newPasswordId" />
                    </div>
                </div>

                <div class="abr-field">
                    <label asp-for="PasswordConfirmation">تکرار رمز عبور جدید</label>
                    <div class="abr-inputwrap">
                        @Icons.Svg("lock")
                        <input asp-for="PasswordConfirmation" class="abr-input ltr" dir="ltr" autocomplete="new-password" aria-required="true" />
                        <partial name="_PasswordToggle" model="confirmId" />
                    </div>
                </div>

                <partial name="_PasswordRules" model="newPasswordId" />

                <button type="submit" class="abr-btn abr-btn--primary abr-btn--block abr-btn--lg">تغییر رمز عبور</button>
            </form>

            <a class="abr-backlink" href="~/dashboard">بازگشت به داشبورد @Icons.Svg("chevron-left", 18)</a>
        </section>
    </div>
</div>
