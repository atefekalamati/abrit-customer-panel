<form asp-area="OrchardCore.Users" asp-controller="ResetPassword" asp-action="ResetPassword" method="post" class="abr-form no-multisubmit" novalidate>
    @if (Model.Content != null)
    {
        @await DisplayAsync(Model.Content)
    }

    <button type="submit" class="abr-btn abr-btn--primary abr-btn--block abr-btn--lg">ذخیره‌ی رمز عبور</button>
</form>
