@model LoginViewModel
@{
    var allowRememberMe = Site.GetOrCreate<LoginSettings>().AllowRememberMe;
    var passwordId = Html.IdFor(m => m.Password);
}
<div class="abr-field">
    <label asp-for="UserName">نام کاربری یا ایمیل</label>
    <div class="abr-inputwrap">
        @Icons.Svg("user")
        <input asp-for="UserName" class="abr-input ltr" dir="ltr" autocomplete="username" autocapitalize="none" spellcheck="false" aria-required="true" autofocus />
    </div>
</div>

<div class="abr-field">
    <label asp-for="Password">رمز عبور</label>
    <div class="abr-inputwrap">
        @Icons.Svg("lock")
        <input asp-for="Password" class="abr-input ltr" dir="ltr" autocomplete="current-password" aria-required="true" />
        <partial name="_PasswordToggle" model="passwordId" />
    </div>
</div>

@if (allowRememberMe)
{
    <label class="abr-check">
        <input asp-for="RememberMe" />
        <span>مرا به خاطر بسپار</span>
    </label>
}
