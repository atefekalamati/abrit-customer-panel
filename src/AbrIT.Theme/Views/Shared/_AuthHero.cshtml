<section class="abr-hero" aria-labelledby="abr-hero-title">
    <div class="abr-hero__top">
        <div class="abr-hero__text">
            <h2 class="abr-hero__title" id="abr-hero-title">به <bdi class="abr-hero__brand">AbrIT</bdi> خوش آمدید</h2>
            <p class="abr-hero__sub">پلتفرم سرویس‌های ابری سازمانی برای کسب‌وکارها و تیم‌ها</p>
        </div>
        <div class="abr-hero__art"><img src="~/AbrIT.Theme/img/hero-laptop.webp" alt="" width="900" height="586" decoding="async" fetchpriority="high" /></div>
    </div>
    <ul class="abr-features">
        <li>@Icons.Svg("cloud", 34)<strong><bdi>AbrIT Drive</bdi></strong><span>فضای ذخیره‌سازی امن</span></li>
        <li>@Icons.Svg("users", 34)<strong>مدیریت تیم</strong><span>تعریف و کنترل کاربران</span></li>
        <li>@Icons.Svg("shield", 34)<strong>امنیت و دسترسی</strong><span>حفاظت از داده‌های شما</span></li>
        <li>@Icons.Svg("zap", 34)<strong>دسترسی سریع</strong><span>همیشه و از هرجا</span></li>
    </ul>
</section>
