@* Decorative cloud badge for forgot/reset (model: "lock" | "key"). Pure SVG with token colours. *@
@model string
<svg viewBox="0 0 260 170" width="260" height="170" role="presentation" focusable="false">
    <defs>
        <linearGradient id="ac-cloud-@Model" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" style="stop-color:var(--abr-blue-100)" />
            <stop offset=".35" style="stop-color:color-mix(in srgb, var(--abr-primary) 70%, white)" />
            <stop offset="1" style="stop-color:var(--abr-primary)" />
        </linearGradient>
        <radialGradient id="ac-halo-@Model">
            <stop offset="0" style="stop-color:var(--abr-surface)" stop-opacity=".95" />
            <stop offset="1" style="stop-color:var(--abr-surface)" stop-opacity="0" />
        </radialGradient>
    </defs>
    <ellipse cx="130" cy="120" rx="128" ry="48" fill="url(#ac-halo-@Model)" />
    <g fill="url(#ac-cloud-@Model)">
        <circle cx="92" cy="104" r="42" />
        <circle cx="138" cy="74" r="58" />
        <circle cx="186" cy="106" r="40" />
        <rect x="52" y="100" width="174" height="56" rx="28" />
    </g>
    @if (Model == "key")
    {
        <g fill="none" style="stroke:var(--abr-surface)" stroke-width="9" stroke-linecap="round">
            <circle cx="116" cy="122" r="16" />
            <path d="M128 110 166 72" />
            <path d="M156 82l9 9M146 92l7 7" />
        </g>
    }
    else
    {
        <path d="M124 104V92a16 16 0 0 1 32 0v12" fill="none" style="stroke:var(--abr-surface)" stroke-width="8" />
        <rect x="114" y="102" width="52" height="42" rx="9" style="fill:var(--abr-surface)" />
        <circle cx="140" cy="119" r="6" style="fill:var(--abr-primary)" />
        <rect x="137" y="121" width="6" height="12" rx="3" style="fill:var(--abr-primary)" />
        <path d="M168 58a40 40 0 0 1 22 30" fill="none" style="stroke:var(--abr-surface)" stroke-width="6" stroke-linecap="round" />
        <path d="M182 86l9 6 5-10" fill="none" style="stroke:var(--abr-surface)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
    }
</svg>
