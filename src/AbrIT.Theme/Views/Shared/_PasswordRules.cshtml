@* Live checklist under a new-password input (model = input id). Rules come from the real IdentityOptions, so the list
   never promises something the server does not enforce. theme.js ticks them while typing. *@
@model string
@inject IOptions<IdentityOptions> Identity
@{
    var p = Identity.Value.Password;
    var rules = new List<(string Key, int N, IHtmlContent Text)>
    {
        ("len", p.RequiredLength, new HtmlString($"حداقل {Labels.Digits(p.RequiredLength)} کاراکتر")),
    };
    if (p.RequireUppercase)
    {
        rules.Add(("upper", 0, new HtmlString("یک حرف بزرگ انگلیسی")));
    }
    if (p.RequireLowercase)
    {
        rules.Add(("lower", 0, new HtmlString("یک حرف کوچک انگلیسی")));
    }
    if (p.RequireDigit)
    {
        rules.Add(("digit", 0, new HtmlString("یک عدد")));
    }
    if (p.RequireNonAlphanumeric)
    {
        rules.Add(("symbol", 0, new HtmlString("یک نماد مثل <bdi>!</bdi> یا <bdi>@</bdi>")));
    }
    if (p.RequiredUniqueChars > 1)
    {
        rules.Add(("unique", p.RequiredUniqueChars, new HtmlString($"حداقل {Labels.Digits(p.RequiredUniqueChars)} نویسه‌ی متفاوت")));
    }
}
<ul class="abr-rules" id="@(Model)-rules" data-abr-rules="@Model">
    @foreach (var rule in rules)
    {
        <li data-rule="@rule.Key" data-n="@rule.N" data-ok="false">
            @Icons.Svg("circle", 18, "abr-ico--todo")@Icons.Svg("check-circle", 18, "abr-ico--ok")
            <span>@rule.Text</span><span class="sr-only">(هنوز رعایت نشده)</span>
        </li>
    }
</ul>
