@* One-shot feedback after a POST/redirect. TempData["AbrMessageKind"] = error|success (default info). *@
@if (TempData["AbrMessage"] is string message)
{
    var kind = TempData["AbrMessageKind"] as string ?? "success";
    <div class="abr-alert abr-alert--@kind abr-flash" role="@(kind == "error" ? "alert" : "status")">
        @Icons.Svg(kind == "error" ? "alert" : "check-circle", 22, "abr-alert__svg")
        <div><p>@message</p></div>
    </div>
}
