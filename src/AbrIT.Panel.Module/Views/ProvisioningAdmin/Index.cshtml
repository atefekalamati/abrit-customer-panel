@model ProvisioningSettingsViewModel
<div dir="rtl" lang="fa">
    <h1>تنظیمات اتصال</h1>
    <partial name="_Message" />
    <dl>
        <dt>حالت اتصال (فقط‌خواندنی، از پیکربندی)</dt><dd><bdi>@Model.Mode</bdi></dd>
        @if (Model.BaseUrl is not null)
        {
            <dt>آدرس Nextcloud</dt><dd><bdi>@Model.BaseUrl</bdi></dd>
        }
        <dt>رمز برنامه (App Password)</dt><dd>@(Model.AppPasswordSet ? "تنظیم شده" : "تنظیم نشده")</dd>
        <dt>حداکثر تلاش برای هر سفارش</dt><dd>@Model.MaxAttempts</dd>
    </dl>
    @if (Model.MockFailNextCalls is { } failNext)
    {
        <h2>شبیه‌سازی خطا (Mock)</h2>
        <p>حساب‌های آزمایشی ساخته‌شده از آخرین راه‌اندازی: @Model.MockAccounts</p>
        <p>فراخوانی‌های بعدی که با خطا مواجه می‌شوند: <strong>@failNext</strong></p>
        <form method="post" asp-area="AbrIT.Panel.Module" asp-controller="ProvisioningAdmin" asp-action="SetMockFailures">
            <input type="hidden" name="failNext" value="1" />
            <button type="submit" class="btn btn-warning">شبیه‌سازی خطا در فراخوانی بعدی</button>
        </form>
        <form method="post" asp-area="AbrIT.Panel.Module" asp-controller="ProvisioningAdmin" asp-action="SetMockFailures">
            <label for="failNext">تعداد فراخوانی‌های ناموفق</label>
            <input id="failNext" name="failNext" type="number" min="0" max="100" value="@failNext" />
            <button type="submit" class="btn btn-secondary">ذخیره</button>
        </form>
    }
</div>
