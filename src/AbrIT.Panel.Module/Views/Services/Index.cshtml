@model IReadOnlyList<ServiceCard>
@{
    RenderTitleSegments(new HtmlString("سرویس‌ها"));
    ViewData["AbrNav"] = "services";
    ViewData["AbrArtMobile"] = true;

    static (string File, int Height) Art(string key) => key switch
    {
        "drive" => ("cloud-folder", 700),
        "erp360" => ("service-erp", 651),
        "desk" => ("service-desk", 874),
        _ => ("service-support", 761),
    };
}
<div class="abr-page">
    @await DisplayAsync(await New.AbrPageHeader(
        Title: "سرویس‌های ابریت",
        Subtitle: "مجموعه‌ای از سرویس‌های ابری و سازمانی برای مدیریت بهتر فایل‌ها، فرآیندها و پشتیبانی IT کسب‌وکار شما.",
        Crumbs: new[] { new Crumb("سرویس‌ها") }))

    <ul class="abr-services" role="list">
        @foreach (var service in Model)
        {
            var art = Art(service.ServiceKey);
            var orderable = service.Availability == "Orderable" && service.ServiceKey == CatalogReader.DriveServiceKey;
            var comingSoon = service.Availability == "ComingSoon";
            var isExternal = !orderable && !comingSoon && !string.IsNullOrEmpty(service.MoreInfoUrl);
            var isAbritLink = isExternal && service.ServiceKey != "desk";
            <li class="abr-svc @(orderable ? "abr-svc--primary" : null)">
                <img class="abr-svc__art" src="@Url.Content($"~/AbrIT.Theme/img/{art.File}.webp")" alt="" width="900" height="@art.Height" decoding="async" />
                <div class="abr-svc__titlerow">
                    <h2 class="abr-svc__title"><bdi>@service.Title</bdi></h2>
                    @if (comingSoon)
                    {
                        <span class="abr-badge abr-badge--soon">به‌زودی</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(service.Summary))
                {
                    <p class="abr-svc__desc">@service.Summary</p>
                }
                <div class="abr-svc__foot">
                    @if (orderable)
                    {
                        <a class="abr-btn abr-btn--primary abr-btn--block abr-btn--lg" asp-area="AbrIT.Panel.Module" asp-controller="Services" asp-action="Drive">
                            مشاهده‌ی پلن‌ها @Icons.Svg("chevron-left", 18)
                        </a>
                    }
                    else if (isExternal)
                    {
                        <a class="abr-svc__link" href="@service.MoreInfoUrl" target="_blank" rel="noopener">
                            @if (isAbritLink)
                            {
                                @Icons.Svg("external", 20)
                            }
                            <span>@(service.MoreInfoText ?? "اطلاعات بیشتر")</span>
                            @if (!isAbritLink)
                            {
                                @Icons.Svg("chevron-left", 18)
                            }
                            <span class="sr-only">(در زبانه‌ی جدید)</span>
                        </a>
                    }
                </div>
            </li>
        }
    </ul>
</div>
