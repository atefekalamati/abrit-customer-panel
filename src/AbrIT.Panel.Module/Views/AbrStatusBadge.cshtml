@* Shape: AbrStatusBadge(Status: OrderStatus, Mode?: ProvisionerMode). Text from Labels (spec §7: Mock never looks real). *@
@{
    OrderStatus status = Model.Status;
    var mode = Model.Mode as ProvisionerMode?;
}
<span class="abr-badge" data-status="@Labels.StatusKey(status, mode)"><span>@Labels.StatusHtml(status, mode)</span></span>
