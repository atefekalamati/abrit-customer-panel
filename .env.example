# Copy to .env and fill in. NEVER commit .env.
# Used by docker compose. `dotnet run` does not read .env: it uses the local launch profile (see README).

# Used by the docker compose app only. Never use Development: order pages fail with HTTP 500 there (D-28).
# Local matches the `dotnet run` launch profile. appsettings.Local.json is not published into the Docker image,
# so Docker still takes every credential from this file.
ASPNETCORE_ENVIRONMENT=Local

# --- Orchard AutoSetup (first run only) ---
ORCHARD_SITE_NAME=AbrIT Panel (Demo)
ORCHARD_ADMIN_USERNAME=admin
ORCHARD_ADMIN_EMAIL=admin@example.test
# Passwords: min 8 chars with upper, lower, digit and symbol (D-22).
ORCHARD_ADMIN_PASSWORD=

# --- Demo customers for isolation tests (AC-07); leave empty to skip ---
DEMO_CUSTOMER_A_PASSWORD=
DEMO_CUSTOMER_B_PASSWORD=

# --- Nextcloud connector ---
# Mock = no network, no keys. Real = OCS Provisioning API (only AbrIT-provided or local docker Nextcloud).
NEXTCLOUD_MODE=Mock
NEXTCLOUD_BASE_URL=
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_TIMEOUT_SECONDS=15
NEXTCLOUD_MOCK_FAIL_NEXT_CALLS=0
# Dev/demo only: Mock waits this many ms before creating the account, to show «در حال فعال‌سازی». Keep 0.
NEXTCLOUD_MOCK_DELAY_MS=0

# --- Simulated payment callback (AC-05); empty = endpoint disabled ---
MOCK_PAYMENT_WEBHOOK_SECRET=

# --- Local Nextcloud for Real-mode testing (compose profile "nextcloud"; see README "Real Nextcloud mode") ---
# Then: NEXTCLOUD_MODE=Real, NEXTCLOUD_BASE_URL=http://nextcloud (app in compose) or http://localhost:8081 (dotnet run),
# NEXTCLOUD_ADMIN_USER=<LOCAL_NEXTCLOUD_ADMIN_USER>, NEXTCLOUD_APP_PASSWORD=<app password created in Nextcloud>.
LOCAL_NEXTCLOUD_ADMIN_USER=ncadmin
LOCAL_NEXTCLOUD_ADMIN_PASSWORD=
